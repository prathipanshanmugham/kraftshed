# Database (Postgres on the VPS, see docker-compose.yml)
DATABASE_URL="postgresql://kraftshed:change_me@db:5432/kraftshed?schema=public"
# Auth — generate with: openssl rand -base64 32
AUTH_SECRET="change_me_long_random_string"
# Public URLs
NEXT_PUBLIC_SITE_URL="https://kraftshed.com"
NEXT_PUBLIC_SITE_NAME="Kraftshed"
# Razorpay (test keys to start)
RAZORPAY_KEY_ID="rzp_test_xxxxxxxx"
RAZORPAY_KEY_SECRET="xxxxxxxxxxxxxxxx"
RAZORPAY_WEBHOOK_SECRET="xxxxxxxxxxxxxxxx"
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_xxxxxxxx"
# Marketplace settings
PLATFORM_COMMISSION_PERCENT="10"
# Admin bootstrap (used by seed)
ADMIN_EMAIL="admin@kraftshed.com"
ADMIN_PASSWORD="ChangeMe@123"
